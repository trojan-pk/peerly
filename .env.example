# ==========================================
# Peerly — Environment Configuration
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
# NEVER commit .env.local or real secrets to git.
# ==========================================

# ------------------------------------------
# MongoDB Connection
# ------------------------------------------
# Local instance or MongoDB Atlas connection string.
# Example local: mongodb://localhost:27017/peerly
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/peerly?retryWrites=true&w=majority
MONGODB_URI=

# ------------------------------------------
# Authentication (Auth.js / NextAuth v5)
# ------------------------------------------
# Secret used to encrypt session tokens and cookies.
# Generate without printing secrets: pnpm setup:env
# Or use openssl rand -base64 32 and paste the result locally.
AUTH_SECRET=your_auth_secret_here_min_32_chars

# Canonical base URL for your application.
# In local development this is typically: http://localhost:3000
AUTH_URL=http://localhost:3000

# ------------------------------------------
# Google OAuth 2.0 Credentials
# ------------------------------------------
# Create credentials in Google Cloud Console:
# 1. Go to https://console.cloud.google.com/apis/credentials
# 2. Create an OAuth 2.0 Client ID (Application type: Web application)
# 3. Add Authorized JavaScript origins: http://localhost:3000
# 4. Add Authorized redirect URIs:
#      http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=your_google_oauth_client_id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=your_google_oauth_client_secret

# ------------------------------------------
# Administrative Access (Optional)
# ------------------------------------------
# Comma-separated list of Google email addresses granted administrative rights for moderation.
# Example: ADMIN_EMAILS=admin@university.edu,moderator@university.edu
ADMIN_EMAILS=

# ------------------------------------------
# Email alerts (Optional)
# ------------------------------------------
# Leave both empty to keep in-app notifications only. With both set, helpers get an
# email for new requests and learners for accepted/declined ones (max 10/hour each).
# Create an API key at https://resend.com/api-keys and verify a sending domain.
# EMAIL_FROM must use that verified domain, e.g. Peerly <alerts@your-domain.edu>.
RESEND_API_KEY=
EMAIL_FROM=
